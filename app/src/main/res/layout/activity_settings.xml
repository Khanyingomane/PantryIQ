<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/electric_plum"
            android:textSize="30sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Make Pantry IQ work the way you cook."
            android:textColor="@color/electric_plum"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <!-- Expiry reminder settings card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_ingredient_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPIRY REMINDERS"
                android:textColor="@color/electric_plum"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <CheckBox
                android:id="@+id/cbExpiryReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/vivid_pink"
                android:checked="true"
                android:minHeight="48dp"
                android:text="Show expiry reminders"
                android:textColor="@color/electric_plum"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Highlights expired ingredients and items expiring within seven days. These reminders appear inside the app, not as phone notifications."
                android:textColor="#76667B"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Measurement preferences card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_ingredient_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREFERRED MEASUREMENT UNIT"
                android:textColor="@color/electric_plum"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <Spinner
                android:id="@+id/spinnerUnitPreference"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/electric_plum"
                android:entries="@array/unit_preferences"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Choose Metric, Kitchen, or Count. Your preference is saved on this device. Existing ingredient quantities are not automatically converted, so recipe matching remains consistent."
                android:textColor="#76667B"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Save settings -->
        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/vivid_pink"
            android:text="Save Settings"
            android:textAllCaps="false"
            android:textColor="@color/clean_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Return to pantry -->
        <Button
            android:id="@+id/btnBackToPantry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/electric_plum"
            android:text="Back to Pantry"
            android:textAllCaps="false"
            android:textColor="@color/clean_white"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>