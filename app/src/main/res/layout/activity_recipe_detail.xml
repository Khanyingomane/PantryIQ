<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/layoutRecipeDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Recipe title -->
        <TextView
            android:id="@+id/tvRecipeDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textColor="@color/electric_plum"
            android:textSize="30sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <!-- Short recipe description -->
        <TextView
            android:id="@+id/tvRecipeDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recipe description"
            android:textColor="@color/electric_plum"
            android:textSize="16sp"
            android:lineSpacingExtra="3dp" />

        <!-- Time and servings summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_ingredient_card">

            <TextView
                android:id="@+id/tvRecipeDetailTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total time: 0 minutes"
                android:textColor="@color/electric_plum"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecipeDetailServings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Servings: 0"
                android:textColor="@color/electric_plum"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Ingredients section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Ingredients"
            android:textColor="@color/electric_plum"
            android:textSize="22sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/tvRecipeDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ingredient_card"
            android:padding="18dp"
            android:text="Recipe ingredients will appear here."
            android:textColor="@color/electric_plum"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:breakStrategy="high_quality" />

        <!-- Cooking instructions section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Cooking Instructions"
            android:textColor="@color/electric_plum"
            android:textSize="22sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/tvRecipeDetailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ingredient_card"
            android:padding="18dp"
            android:text="Cooking instructions will appear here."
            android:textColor="@color/electric_plum"
            android:textSize="16sp"
            android:lineSpacingExtra="7dp"
            android:breakStrategy="high_quality" />

        <!-- Return to recipe suggestions -->
        <Button
            android:id="@+id/btnBackToSuggestions"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/electric_plum"
            android:text="Back to Recipes"
            android:textColor="@color/clean_white"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>

