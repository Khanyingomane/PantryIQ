<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recipeSuggestionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/warm_cream"
    android:padding="20dp">

    <!-- Screen heading -->
    <TextView
        android:id="@+id/tvRecipeHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meals You Can Make"
        android:textColor="@color/electric_plum"
        android:textSize="28sp"
        android:textStyle="bold"
        android:accessibilityHeading="true" />

    <TextView
        android:id="@+id/tvRecipeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="Good meals start with what you already have."
        android:textColor="@color/electric_plum"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <!-- Recipe count accent -->
    <TextView
        android:id="@+id/tvRecipeCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:backgroundTint="@color/lime_pop"
        android:background="@drawable/bg_recipe_count"
        android:text="0 recipes available"
        android:textColor="@color/electric_plum"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:padding="20dp"
        android:gravity="center"
        android:background="@drawable/bg_ingredient_card"
        android:text="No matching recipes yet. Add ingredients or check your pantry quantities to discover meals."
        android:textColor="@color/electric_plum"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />

    <!-- Scrollable recipe results -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/layoutRecipeSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />

    </ScrollView>

    <!-- Return to pantry -->
    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/electric_plum"
        android:text="Back to Pantry"
        android:textColor="@color/clean_white"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
